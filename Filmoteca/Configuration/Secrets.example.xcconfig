TMDB_DEBUG_URL=https:/$()/api.themoviedb.org/3
TMDB_DEBUG_KEY=YOUR_TMDB_HERE

TMDB_STAGING_URL=https:/$()/api.themoviedb.org/3
TMDB_STAGING_KEY=YOUR_TMDB_HERE

TMDB_RELEASE_URL=https:/$()/api.themoviedb.org/3
TMDB_RELEASE_KEY=YOUR_TMDB_HERE

WATCH_DEBUG_MODE_URL=https:/$()/api.watchmode.com/v1
WATCH_DEBUG_MODE_KEY=YOUR_WATCHMODE_HERE

WATCH_STAGING_MODE_URL=https:/$()/api.watchmode.com/v1
WATCH_STAGING_MODE_KEY=YOUR_WATCHMODE_HERE

WATCH_RELEASE_MODE_URL=https:/$()/api.watchmode.com/v1
WATCH_RELEASE_MODE_KEY=YOUR_WATCHMODE_HERE
